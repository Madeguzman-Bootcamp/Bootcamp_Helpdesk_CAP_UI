{
  "name": "bootcamp_bookshop",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy:local": "cds deploy --to sqlite:db.sqlite"
    
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]" : {
        "db": {
          "kind": "sqlite",
          "credentials": { "url": "db.sqlite" }
        }
      }
    }
  }
}
